{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitType(chore)", ":gitSignOff"],
  "semanticCommits": "enabled",
  "enabledManagers": ["custom.regex", "npm", "github-actions"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bump the CloudNativePG operator version pinned in the smoke-test workflow",
      "managerFilePatterns": ["/^\\.github/workflows/smoke-test\\.yml$/"],
      "matchStrings": ["CNPG_VERSION: '(?<currentValue>[\\d.]+)'"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "cloudnative-pg/cloudnative-pg",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Bump the Headlamp version pinned in the smoke-test workflow",
      "managerFilePatterns": ["/^\\.github/workflows/smoke-test\\.yml$/"],
      "matchStrings": ["ref: \"v(?<currentValue>[\\d.]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/headlamp",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
